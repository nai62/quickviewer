 <layoutdefault spacing="6" margin="11"/>
 <customwidgets>
  <customwidget>
   <class>ImageView</class>
   <extends>QGraphicsView</extends>
   <header>imageview.h</header>
   <slots>
    <signal>fittingChanged(qvEnums::FitMode)</signal>
    <signal>anchorHovered(Qt::AnchorPoint)</signal>
    <slot>handleFittingActionTriggered(bool)</slot>
    <slot>handleDualViewActionTriggered(bool)</slot>
    <slot>handleZoomInActionTriggered()</slot>
    <slot>handleZoomOutActionTriggered()</slot>
    <slot>handleRightSideBookActionTriggered(bool)</slot>
    <slot>handleWideImageAsOneViewActionTriggered(bool)</slot>
    <slot>handleOpenFilerActionTriggered()</slot>
    <slot>handleNextPageActionTriggered()</slot>
    <slot>handlePrevPageActionTriggered()</slot>
    <slot>handleFirstPageActionTriggered()</slot>
    <slot>handleLastPageActionTriggered()</slot>
    <slot>handleNextOnePageActionTriggered()</slot>
    <slot>handlePrevOnePageActionTriggered()</slot>
    <slot>handleFirstImageAsOneViewActionTriggered(bool)</slot>
    <slot>handleCopyPageActionTriggered()</slot>
    <slot>handleNextVolumeActionTriggered()</slot>
    <slot>handlePrevVolumeActionTriggered()</slot>
    <slot>handleFastForwardActionTriggered()</slot>
    <slot>handleFastBackwardActionTriggered()</slot>
    <slot>handleCopyFileActionTriggered()</slot>
    <slot>handleRotateActionTriggered()</slot>
    <slot>handleShowSubfoldersActionTriggered(bool)</slot>
    <slot>handleDontEnlargeSmallImagesOnFittingActionTriggered(bool)</slot>
    <slot>handleSeparatePagesWhenWideImageActionTriggered(bool)</slot>
    <slot>handleLoupeToolActionTriggered(bool)</slot>
    <slot>handleScrollWithCursorWhenZoomingActionTriggered(bool)</slot>
