#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v uv >/dev/null 2>&1; then
    echo "error: uv is required for the C++ pre-commit hook." >&2
    echo "Install uv, then retry the commit." >&2
    exit 2
fi

exec uv run --script scripts/lint-cpp.py --staged --fix
